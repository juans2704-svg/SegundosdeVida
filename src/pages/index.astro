---
import Base from '../layouts/Base.astro';
import Header from '../components/sections/Header.astro';
import Hero from '../components/sections/Hero.astro';
import Story from '../components/sections/Story.astro';
import Works from '../components/sections/Works.astro';
import Donate from '../components/sections/Donate.astro';
import Thanks from '../components/sections/Thanks.astro';
import Transparency from '../components/sections/Transparency.astro';
import Footer from '../components/sections/Footer.astro';
import Toast from '../components/ui/Toast.astro';
import DemoPanel from '../components/ui/DemoPanel.astro';
---

<Base>
  <Header />
  <main id="main">
    <Hero />
    <Story />
    <Works />
    <Donate />
    <Thanks />
    <Transparency />
  </main>
  <Footer />
  <Toast />
  <DemoPanel />
</Base>

<script>
  import '../scripts/progress';
  import '../scripts/donation';
</script>
