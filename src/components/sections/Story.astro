---
import Character from '../characters/Character.astro';
import type { CharacterId } from '../../config/characters';
import SpeechBubble from '../ui/SpeechBubble.astro';
import t from '../../i18n/es';
---

<section class="section story" id="historia" aria-labelledby="story-title">
  <div class="wrap">
    <div class="story__talk" data-reveal>
      <div class="story__calvita">
        <Character who="calvita" />
      </div>
      <SpeechBubble html={t.story.speech} tail="left" tone="yellow" />
    </div>

    <div class="story__body" data-reveal>
      <h2 id="story-title">{t.story.title}</h2>
      <p class="lead">{t.story.body}</p>
      <ul class="features">
        {
          t.story.features.map((f) => (
            <li class="card feature">
              <span class="feature__icon" aria-hidden="true">
                {f.icon}
              </span>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="dreams" data-reveal>
      <h3 class="dreams__title">{t.story.dreamsTitle}</h3>
      <p class="dreams__body">{t.story.dreamsBody}</p>
      <ul class="dreams__list">
        {
          t.story.dreams.map((d) => (
            <li>
              <Character who={d.who as CharacterId} />
              <p>{d.caption}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="banner" data-reveal>
      <p>{t.story.banner}</p>
      <a class="btn btn--yellow" href="#donar">{t.story.cta}</a>
    </div>
  </div>
</section>

<style>
  .story {
    background: var(--cream);
  }
  .story__talk {
    display: grid;
    grid-template-columns: minmax(110px, 190px) 1fr;
    align-items: center;
    gap: 1.5rem;
    max-width: 820px;
    margin-bottom: clamp(48px, 7vw, 80px);
    font-size: 1.1rem;
  }
  .lead {
    max-width: 62ch;
    font-size: 1.2rem;
  }
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.2rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }
  .feature {
    padding: 1.4rem;
  }
  @media (max-width: 640px) {
    .features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.7rem;
    }
    .feature {
      padding: 0.9rem;
    }
    .feature h3 {
      font-size: 1.05rem;
    }
    .feature p {
      font-size: 0.9rem;
      line-height: 1.35;
    }
  }
  .feature:nth-child(1) {
    background: #ffe3e2;
  }
  .feature:nth-child(2) {
    background: #e1f1ff;
  }
  .feature:nth-child(3) {
    background: #f1e6fb;
  }
  .feature:nth-child(4) {
    background: #e2f5e3;
  }
  .feature__icon {
    font-size: 2.2rem;
  }
  .feature h3 {
    margin: 0.3rem 0 0.2rem;
  }
  .feature p {
    margin: 0;
  }
  .dreams {
    margin-top: clamp(48px, 7vw, 80px);
    text-align: center;
  }
  .dreams__title {
    font-size: clamp(1.6rem, 3.6vw, 2.4rem);
    margin-bottom: 0.4rem;
  }
  .dreams__body {
    max-width: 58ch;
    margin: 0 auto 1.6rem;
    font-size: 1.1rem;
  }
  .dreams__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.2rem, 4vw, 2.5rem) clamp(0.5rem, 3vw, 2.5rem);
    max-width: 860px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  .dreams__list li {
    display: grid;
    justify-items: center;
    align-content: end;
    gap: 0.5rem;
  }
  .dreams__list :global(.character) {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
    height: clamp(140px, 30vw, 250px);
  }
  .dreams__list :global(.character img) {
    width: auto;
    max-width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .dreams__list li:nth-child(2n) :global(.character) {
    animation: bob 3.6s ease-in-out infinite;
  }
  .dreams__list p {
    margin: 0;
    padding: 0.2rem 0.8rem;
    border: 2.5px solid var(--ink);
    border-radius: 999px;
    background: var(--yellow);
    font-weight: 800;
    font-size: clamp(0.72rem, 2.4vw, 1rem);
    line-height: 1.25;
  }
  @media (max-width: 560px) {
    .dreams__list p {
      padding: 0.2rem 0.5rem;
      border-width: 2px;
    }
  }
  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dreams__list :global(.character) {
      animation: none !important;
    }
  }
  .banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem 2rem;
    margin-top: clamp(48px, 7vw, 80px);
    padding: clamp(24px, 4vw, 40px);
    border: 3px solid var(--ink);
    border-radius: var(--radius);
    background: var(--red-strong);
    color: var(--white);
    box-shadow: var(--shadow);
  }
  .banner p {
    margin: 0;
    max-width: 34ch;
    font-size: clamp(1.35rem, 3vw, 1.9rem);
    font-weight: 800;
    line-height: 1.2;
  }
  @media (max-width: 520px) {
    .story__talk {
      grid-template-columns: 1fr;
    }
    .story__calvita {
      width: 130px;
    }
    .banner .btn {
      width: 100%;
    }
  }
</style>
