---
import House from '../house/House.astro';
import { campaign, stages } from '../../config/campaign';
import t from '../../i18n/es';
---

<section class="section works" id="obra" aria-labelledby="works-title">
  <div class="wrap works__grid">
    <div data-reveal>
      <p class="eyebrow">{t.works.eyebrow}</p>
      <h2 id="works-title">{t.works.title}</h2>
      <p class="lead">{t.works.body}</p>
      <p class="address">📍 {campaign.address}</p>
    </div>

    <!--
      PENDIENTE: reemplazar las dos ilustraciones por la foto real de la obra
      y el render de la casa terminada (WebP/AVIF, con loading="lazy").
    -->
    <figure class="compare card" data-compare data-reveal>
      <div class="compare__frame">
        <div class="compare__layer">
          <House uid="after" level={5} label={t.works.afterNote} />
        </div>
        <div class="compare__layer compare__before" data-compare-before>
          <House uid="before" level={0} label={t.works.beforeNote} />
        </div>
        <span class="compare__line" data-compare-line aria-hidden="true"></span>
        <span class="tag tag--before">{t.works.before}</span>
        <span class="tag tag--after">{t.works.after}</span>
      </div>
      <label class="visually-hidden" for="compare-range">{t.works.sliderLabel}</label>
      <input id="compare-range" class="compare__range" type="range" min="0" max="100" value="50" data-compare-range />
      <figcaption>{t.works.beforeNote} · {t.works.afterNote}</figcaption>
    </figure>
  </div>

  <div class="wrap">
    <h3 class="stages-title">{t.works.stagesTitle}</h3>
    <ol class="stages">
      {
        stages.map((s) => (
          <li class="stage card" data-reveal>
            <span class="stage__icon" aria-hidden="true">
              {s.icon}
            </span>
            <div>
              <h4>{s.name}</h4>
              <p>{s.description}</p>
            </div>
            <span class="stage__pct">{s.budgetPct}%</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-compare]').forEach((el) => {
    const range = el.querySelector<HTMLInputElement>('[data-compare-range]')!;
    const before = el.querySelector<HTMLElement>('[data-compare-before]')!;
    const line = el.querySelector<HTMLElement>('[data-compare-line]')!;
    const update = () => {
      const v = Number(range.value);
      before.style.clipPath = `inset(0 ${100 - v}% 0 0)`;
      line.style.left = `${v}%`;
    };
    range.addEventListener('input', update);
    update();
  });
</script>

<style>
  .works {
    background: var(--sky-light);
  }
  .works__grid {
    display: grid;
    gap: 2rem 3rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .works__grid {
      grid-template-columns: 0.9fr 1.1fr;
    }
  }
  .lead {
    font-size: 1.2rem;
  }
  .address {
    font-weight: 700;
  }
  .compare {
    margin: 0;
    padding: 1rem;
  }
  .compare__frame {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    background: linear-gradient(180deg, #bfe6fa, #fff);
  }
  .compare__layer {
    padding: 1rem 0.5rem 0;
  }
  .compare__before {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #cfd8e0, #eef2f5);
  }
  .compare__line {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 4px;
    margin-left: -2px;
    background: var(--ink);
    pointer-events: none;
  }
  .compare__line::after {
    content: '⇆';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 3px solid var(--ink);
    border-radius: 50%;
    background: var(--yellow);
    font-weight: 800;
  }
  .tag {
    position: absolute;
    top: 10px;
    padding: 0.1rem 0.7rem;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--white);
    font-weight: 800;
    font-size: 0.9rem;
  }
  .tag--before {
    left: 10px;
  }
  .tag--after {
    right: 10px;
    background: var(--yellow);
  }
  .compare__range {
    width: 100%;
    margin: 1rem 0 0.3rem;
    accent-color: var(--red-strong);
    min-height: 32px;
  }
  figcaption {
    font-size: 0.85rem;
    color: var(--ink-soft);
  }
  .stages-title {
    margin-top: clamp(48px, 7vw, 80px);
    font-size: clamp(1.5rem, 3vw, 2rem);
  }
  .stages {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
    margin: 1.2rem 0 0;
    padding: 0;
    list-style: none;
  }
  .stage {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.2rem;
  }
  .stage__icon {
    font-size: 2rem;
  }
  .stage h4 {
    margin: 0;
    font-size: 1.15rem;
  }
  .stage p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }
  .stage__pct {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--red-text);
  }
</style>
