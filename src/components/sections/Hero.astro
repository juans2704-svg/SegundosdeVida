---
import HouseFrames from '../house/HouseFrames.astro';
import Character from '../characters/Character.astro';
import SpeechBubble from '../ui/SpeechBubble.astro';
import ProgressPanel from '../ui/ProgressPanel.astro';
import { getInitialProgress, percentOf } from '../../lib/progress';
import t from '../../i18n/es';

const pct = percentOf(getInitialProgress());
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="cloud" style="left:4%;top:90px" aria-hidden="true"></div>
  <div class="cloud cloud--b" style="right:6%;top:220px" aria-hidden="true"></div>
  <div class="cloud cloud--c" style="left:40%;bottom:60px" aria-hidden="true"></div>

  <div class="wrap hero__grid">
    <div class="hero__intro">
      <p class="eyebrow">{t.hero.badge}</p>
      <h1 id="hero-title">{t.hero.title}</h1>
    </div>

    <div class="hero__house card">
      <HouseFrames pct={pct} label={t.hero.houseAlt} />
      <ProgressPanel />
    </div>

    <div class="hero__talk">
      <div class="hero__calvito">
        <Character who="calvito" eager />
      </div>
      <SpeechBubble html={t.hero.speech} tail="left" />
    </div>

    <div class="hero__ctas">
      <a class="btn btn--primary" href="#donar">{t.hero.ctaPrimary}</a>
      <a class="btn btn--white" href="#historia">{t.hero.ctaSecondary}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(28px, 5vw, 64px) clamp(56px, 8vw, 96px);
    background: linear-gradient(180deg, var(--sky) 0%, #9bd6f6 70%, var(--sky-light) 100%);
  }
  .cloud--b {
    transform: scale(0.7);
  }
  .cloud--c {
    transform: scale(1.2);
    opacity: 0.6;
  }
  .hero__grid {
    position: relative;
    display: grid;
    gap: 1.5rem 3rem;
    grid-template-columns: 1fr;
    grid-template-areas:
      'intro'
      'house'
      'talk'
      'ctas';
  }
  .hero__intro {
    grid-area: intro;
  }
  .hero__intro h1 {
    margin: 0;
  }
  .hero__house {
    grid-area: house;
    display: grid;
    gap: 1rem;
    padding: clamp(14px, 3vw, 24px);
    background: linear-gradient(180deg, #d8f0fd 0%, var(--white) 62%);
  }
  .hero__talk {
    grid-area: talk;
    display: grid;
    grid-template-columns: minmax(96px, 150px) 1fr;
    align-items: start;
    gap: 1rem;
  }
  .hero__calvito {
    animation: bob 3.4s ease-in-out infinite;
  }
  .hero__ctas {
    grid-area: ctas;
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 1rem;
  }

  @media (min-width: 960px) {
    .hero__grid {
      grid-template-columns: 1fr 1.05fr;
      grid-template-areas:
        'intro house'
        'talk  house'
        'ctas  house';
      align-items: start;
    }
    .hero__house {
      position: sticky;
      top: 90px;
    }
  }
  @media (max-width: 520px) {
    .hero__talk {
      grid-template-columns: 1fr;
    }
    .hero__calvito {
      width: 120px;
    }
    .hero__ctas .btn {
      width: 100%;
    }
  }
  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }
</style>
