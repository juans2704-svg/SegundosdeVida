---
/**
 * LA SUPERCASA animada (brief §7.1), dibujada a partir del arte oficial
 * (public/img/supercasa-render.webp).
 *
 * Cada elemento con `data-at="N"` aparece cuando el recaudo llega a N% y cada
 * `data-until="N"` desaparece al llegar a N%: la casa cambia cada 5%.
 * `src/scripts/progress.ts` alterna las clases `on` / `off` en el navegador;
 * aquí se calcula el estado inicial con `pct`.
 *
 *  0  Obra gris: concreto, vanos oscuros, grúa, andamio, cerca de obra
 *  5  Materiales en el andén           55  Ventanal-casa con marco verde
 * 10  Placa de cubierta                60  Cornisas de fachada
 * 15  Baranda de azotea (grúa activa)  65  Luces de los pisos altos
 * 20  Jardineras en la azotea          70  Luces de toda la casa
 * 25  Primeros brotes                  75  Letrero LA SUPER CASA
 * 30  Arbustos en la azotea            80  Interiores: plantas y lámparas
 * 35  Enredaderas (jardín listo)       85  Árboles y arbustos (sin andamio)
 * 40  Fachada en ladrillo, abajo       90  Reja negra (sin grúa ni cerca)
 * 45  Fachada en ladrillo, arriba      95  Luces de azotea, familia llegando
 * 50  Ventanas con marco y vidrio     100  Celebración
 */
import { campaign } from '../../config/campaign';

interface Props {
  /** % de recaudo con el que se dibuja inicialmente. */
  pct?: number;
  /** Prefijo único para ids internos cuando hay varias casas en la página. */
  uid: string;
  label: string;
  id?: string;
  class?: string;
  fit?: 'meet' | 'slice';
}

const { pct = 0, uid, label, id, class: className = '', fit = 'meet' } = Astro.props;
const cls = (...c: (string | false)[]) => c.filter(Boolean).join(' ') || undefined;
const at = (n: number, base = '') => ({ 'data-at': n, class: cls(base, pct >= n && 'on') });
const until = (n: number, base = '') => ({ 'data-until': n, class: cls(base, pct >= n && 'off') });

// Geometría: edificio de x=130 a x=330, de y=60 a y=350, 5 pisos de 58px.
const rowTops = [60, 118, 176, 234, 292];
const colX = [142, 205, 268];
const W = 50;
const H = 42;
const upperWindows = rowTops.slice(0, 3).flatMap((y, r) => colX.map((x) => ({ x, y: y + 8, row: r })));
const lowerWindows = [
  { x: 142, y: 242, row: 3 },
  { x: 142, y: 300, row: 4 },
];
const windows = [...upperWindows, ...lowerWindows];
// Ventanal en forma de casa (pisos 1 y 2, columnas 2 y 3)
const entrance = 'M200 350 V272 L260 240 L320 272 V350 Z';
const columns = [130, 196, 259, 324];
const slabs = [118, 176, 234, 292];

const city = [
  { x: 0, y: 214, w: 44, h: 146, c: '#5DADE2' },
  { x: 40, y: 250, w: 52, h: 110, c: '#F7DC6F' },
  { x: 92, y: 282, w: 30, h: 78, c: '#EC7063' },
  { x: 336, y: 238, w: 34, h: 122, c: '#F7DC6F' },
  { x: 368, y: 204, w: 50, h: 156, c: '#5DADE2' },
  { x: 418, y: 254, w: 62, h: 106, c: '#EC7063' },
  { x: 446, y: 222, w: 34, h: 40, c: '#82E0AA' },
];

const bulbs = Array.from({ length: 12 }, (_, i) => ({
  x: 134 + i * 17.5,
  y: 34 + Math.sin((i / 11) * Math.PI) * 6,
  c: ['#FFD400', '#E53935', '#4CAF50', '#2F80ED', '#F06292'][i % 5],
}));
const roofBushes = Array.from({ length: 11 }, (_, i) => ({ x: 136 + i * 19, r: 9 + (i % 3) * 2 }));
const sprouts = Array.from({ length: 14 }, (_, i) => 138 + i * 14.5);
const vines = [146, 178, 214, 250, 286, 316];
const starPoints = (cx: number, cy: number, r: number) =>
  Array.from({ length: 10 }, (_, i) => {
    const rad = i % 2 === 0 ? r : r * 0.45;
    const a = (Math.PI / 5) * i - Math.PI / 2;
    return `${(cx + rad * Math.cos(a)).toFixed(1)},${(cy + rad * Math.sin(a)).toFixed(1)}`;
  }).join(' ');
const confetti = [
  { x: 110, y: 20, c: '#FFD400', s: 7 },
  { x: 340, y: 18, c: '#E53935', s: 6 },
  { x: 70, y: 120, c: '#4CAF50', s: 6 },
  { x: 230, y: 12, c: '#8E5CC9', s: 5 },
  { x: 460, y: 200, c: '#F06292', s: 6 },
];
---

<svg
  id={id}
  class:list={['house', className, { 'is-active': pct >= campaign.activeConstructionPct }]}
  viewBox="0 0 480 400"
  preserveAspectRatio={`xMidYMid ${fit}`}
  role="img"
  aria-label={label}
>
  <defs>
    <linearGradient id={`${uid}-sky`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#8FD3F7" />
      <stop offset="1" stop-color="#DDF2FD" />
    </linearGradient>
    <linearGradient id={`${uid}-warm`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FFE7A3" />
      <stop offset="1" stop-color="#FFB74D" />
    </linearGradient>
    <pattern id={`${uid}-brick`} width="20" height="10" patternUnits="userSpaceOnUse">
      <rect width="20" height="10" fill="#EBCB9C" />
      <path d="M0 0.5H20M0 5.5H20M10 0.5V5.5M0 5.5V10M20 5.5V10" stroke="#D3AE7C" stroke-width="1" />
    </pattern>
    <mask id={`${uid}-holes`} maskUnits="userSpaceOnUse" x="0" y="0" width="480" height="400">
      <rect width="480" height="400" fill="#fff" />
      {windows.map((w) => <rect x={w.x} y={w.y} width={W} height={H} fill="#000" />)}
      <path d={entrance} fill="#000" />
    </mask>
    <filter id={`${uid}-glow`} x="-40%" y="-40%" width="180%" height="180%">
      <feGaussianBlur stdDeviation="4" result="b" />
      <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
    </filter>
  </defs>

  <!-- Cielo, sol, nubes y ciudad de colores -->
  <rect width="480" height="400" fill={`url(#${uid}-sky)`} />
  <g class="h-sun">
    <circle cx="438" cy="44" r="24" fill="#FFD400" />
    <path
      d="M438 8v8M438 72v8M402 44h8M466 44h8M413 19l6 6M457 63l6 6M463 19l-6 6M419 63l-6 6"
      stroke="#FFC107"
      stroke-width="4"
      stroke-linecap="round"
    />
  </g>
  <g fill="#fff" opacity=".95">
    <ellipse cx="70" cy="44" rx="34" ry="12" /><ellipse cx="88" cy="36" rx="20" ry="14" />
    <ellipse cx="300" cy="22" rx="28" ry="9" /><ellipse cx="314" cy="16" rx="16" ry="10" />
  </g>
  <g class="h-city" opacity=".8">
    {
      city.map((b) => (
        <g>
          <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="4" fill={b.c} />
          {Array.from({ length: Math.floor(b.h / 26) }, (_, i) => (
            <rect x={b.x + b.w / 2 - 6} y={b.y + 10 + i * 26} width="12" height="12" rx="2" fill="#fff" opacity=".55" />
          ))}
        </g>
      ))
    }
  </g>

  <!-- Suelo: pasto, andén y calle -->
  <rect x="0" y="350" width="480" height="8" fill="#7CC35B" />
  <rect x="0" y="358" width="480" height="18" fill="#D9DEE3" />
  <rect x="0" y="376" width="480" height="24" fill="#8C97A4" />
  <path d="M10 389h30M70 389h30M130 389h30M190 389h30M250 389h30M310 389h30M370 389h30M430 389h30" stroke="#fff" stroke-width="3" />

  <!-- Grúa (hasta 90%) -->
  <g {...until(90, 'h-crane')}>
    <rect x="40" y="22" width="12" height="328" fill="#FFB300" stroke="#1D2B4F" stroke-width="2" />
    <path
      d="M40 50l12 20M52 50l-12 20M40 90l12 20M52 90l-12 20M40 130l12 20M52 130l-12 20M40 170l12 20M52 170l-12 20M40 210l12 20M52 210l-12 20M40 250l12 20M52 250l-12 20M40 290l12 20M52 290l-12 20"
      stroke="#1D2B4F"
      stroke-width="1.4"
    />
    <rect x="14" y="20" width="282" height="9" fill="#FFB300" stroke="#1D2B4F" stroke-width="2" />
    <rect x="14" y="29" width="20" height="14" fill="#5B6573" stroke="#1D2B4F" stroke-width="2" />
    <rect x="36" y="6" width="20" height="16" rx="3" fill="#E53935" stroke="#1D2B4F" stroke-width="2" />
    <g class="h-hook">
      <line x1="250" y1="29" x2="250" y2="40" stroke="#1D2B4F" stroke-width="2" />
      <rect x="238" y="40" width="24" height="9" fill="#A7AFB8" stroke="#1D2B4F" stroke-width="1.5" />
    </g>
  </g>

  <!-- Estructura en concreto (obra gris) -->
  <g class="h-structure">
    <rect x="130" y="60" width="200" height="290" fill="#A7AFB8" />
    {windows.map((w) => <rect x={w.x} y={w.y} width={W} height={H} fill="#3B4048" />)}
    <path d={entrance} fill="#3B4048" />
    {columns.map((x) => <rect x={x} y="60" width="6" height="290" fill="#8C949E" />)}
    {slabs.map((y) => <rect x="124" y={y} width="212" height="6" fill="#8C949E" stroke="#1D2B4F" stroke-width="1" />)}
    <rect x="130" y="60" width="200" height="290" fill="none" stroke="#1D2B4F" stroke-width="2.5" />
  </g>
  <g {...until(10)}>
    {columns.map((x) => <path d={`M${x + 1} 60V46M${x + 5} 60V50`} stroke="#6B4F3A" stroke-width="2" />)}
  </g>

  <!-- 10: placa de cubierta -->
  <g {...at(10)}>
    <rect x="124" y="52" width="212" height="10" fill="#C99A64" stroke="#1D2B4F" stroke-width="2" />
  </g>
  <!-- 15: baranda de azotea -->
  <g {...at(15)}>
    <path d="M128 52V36M332 52V36M128 38H332" stroke="#1D2B4F" stroke-width="2.5" fill="none" />
    <path d="M154 52V38M180 52V38M206 52V38M232 52V38M258 52V38M284 52V38M310 52V38" stroke="#1D2B4F" stroke-width="1.2" />
  </g>
  <!-- 20: jardineras -->
  <g {...at(20)}>
    <rect x="130" y="42" width="200" height="11" rx="2" fill="#8D5A3B" stroke="#1D2B4F" stroke-width="1.5" />
  </g>
  <!-- 25: brotes -->
  <g {...at(25)}>
    {sprouts.map((x) => <path d={`M${x} 43q-3 -7 -7 -8M${x} 43q3 -8 7 -9`} stroke="#43A047" stroke-width="2.5" fill="none" stroke-linecap="round" />)}
  </g>
  <!-- 30: arbustos de la azotea -->
  <g {...at(30)}>
    {roofBushes.map((b, i) => <circle cx={b.x} cy={44 - b.r / 2} r={b.r} fill={i % 2 ? '#2E7D32' : '#43A047'} />)}
    <circle cx="160" cy="30" r="2.6" fill="#FFD400" />
    <circle cx="240" cy="28" r="2.6" fill="#F06292" />
    <circle cx="300" cy="31" r="2.6" fill="#FFD400" />
  </g>
  <!-- 35: enredaderas (jardín listo) -->
  <g {...at(35)}>
    {vines.map((x, i) => <path d={`M${x} 52q${i % 2 ? 6 : -6} 12 0 ${18 + (i % 3) * 6}`} stroke="#2E7D32" stroke-width="5" fill="none" stroke-linecap="round" />)}
  </g>

  <!-- 40 y 45: fachada en ladrillo -->
  <g mask={`url(#${uid}-holes)`}>
    <rect {...at(40)} x="130" y="234" width="200" height="116" fill={`url(#${uid}-brick)`} />
    <rect {...at(45)} x="130" y="62" width="200" height="172" fill={`url(#${uid}-brick)`} />
  </g>
  <g {...at(45)}>
    <rect x="130" y="60" width="200" height="290" fill="none" stroke="#1D2B4F" stroke-width="2.5" />
  </g>

  <!-- 50: ventanas -->
  <g {...at(50)}>
    {
      windows.map((w) => (
        <g>
          <rect x={w.x} y={w.y} width={W} height={H} rx="2" fill="#2B2F36" />
          <rect x={w.x + 4} y={w.y + 4} width={W - 8} height={H - 8} fill="#A9D4EE" />
          <path d={`M${w.x + W / 2} ${w.y + 4}V${w.y + H - 4}`} stroke="#2B2F36" stroke-width="2.5" />
        </g>
      ))
    }
  </g>
  <!-- 55: ventanal-casa con marco verde -->
  <g {...at(55)}>
    <path d={entrance} fill="#A9D4EE" stroke="#C6D930" stroke-width="7" stroke-linejoin="round" />
    <path d="M230 257V350M260 241V350M290 257V350M203 300H317" stroke="#2B2F36" stroke-width="2.5" />
  </g>
  <!-- 60: cornisas -->
  <g {...at(60)}>
    {slabs.slice(0, 3).map((y) => <rect x="126" y={y - 2} width="208" height="5" rx="2" fill="#F7E6C8" stroke="#1D2B4F" stroke-width="1" />)}
    <rect x="126" y="232" width="70" height="5" rx="2" fill="#F7E6C8" stroke="#1D2B4F" stroke-width="1" />
    <rect x="126" y="290" width="70" height="5" rx="2" fill="#F7E6C8" stroke="#1D2B4F" stroke-width="1" />
  </g>

  <!-- 65 y 70: luces encendidas -->
  <g {...at(65)} filter={`url(#${uid}-glow)`}>
    {upperWindows.map((w) => <rect x={w.x + 4} y={w.y + 4} width={W - 8} height={H - 8} fill={`url(#${uid}-warm)`} />)}
  </g>
  <g {...at(70)} filter={`url(#${uid}-glow)`}>
    {lowerWindows.map((w) => <rect x={w.x + 4} y={w.y + 4} width={W - 8} height={H - 8} fill={`url(#${uid}-warm)`} />)}
    <path d="M204 348V274L260 245L316 274V348Z" fill={`url(#${uid}-warm)`} />
  </g>
  <g {...at(65)}>
    {upperWindows.map((w) => <path d={`M${w.x + W / 2} ${w.y + 4}V${w.y + H - 4}`} stroke="#2B2F36" stroke-width="2.5" />)}
  </g>
  <g {...at(70)}>
    {lowerWindows.map((w) => <path d={`M${w.x + W / 2} ${w.y + 4}V${w.y + H - 4}`} stroke="#2B2F36" stroke-width="2.5" />)}
    <path d="M230 257V350M260 241V350M290 257V350M203 300H317" stroke="#2B2F36" stroke-width="2.5" />
  </g>

  <!-- 80: interiores (plantas, lámparas y sala) -->
  <g {...at(80)}>
    {
      windows.map((w, i) => (
        <g>
          <line x1={w.x + (i % 2 ? 14 : 36)} y1={w.y + 4} x2={w.x + (i % 2 ? 14 : 36)} y2={w.y + 12} stroke="#5D4037" stroke-width="1.2" />
          <circle cx={w.x + (i % 2 ? 14 : 36)} cy={w.y + 14} r="3.2" fill="#FFF3C4" />
          <rect x={w.x + (i % 2 ? 32 : 8)} y={w.y + H - 13} width="8" height="7" fill="#8D5A3B" />
          <circle cx={w.x + (i % 2 ? 36 : 12)} cy={w.y + H - 16} r="6" fill="#43A047" />
        </g>
      ))
    }
    <rect x="226" y="326" width="68" height="16" rx="5" fill="#7E57C2" stroke="#1D2B4F" stroke-width="1.5" />
    <rect x="232" y="318" width="56" height="10" rx="4" fill="#9575CD" />
    <circle cx="212" cy="330" r="9" fill="#43A047" /><rect x="207" y="336" width="10" height="10" fill="#8D5A3B" />
    <circle cx="308" cy="330" r="9" fill="#43A047" /><rect x="303" y="336" width="10" height="10" fill="#8D5A3B" />
    <circle cx="260" cy="270" r="6" fill="#FFF3C4" stroke="#5D4037" stroke-width="1" />
  </g>

  <!-- Andamio (hasta 85%) -->
  <g {...until(85, 'h-scaffold')}>
    <path
      d="M106 70V350M126 70V350M106 118H126M106 176H126M106 234H126M106 292H126M106 118L126 176M126 176L106 234M106 234L126 292M126 292L106 350"
      stroke="#5B6573"
      stroke-width="3"
    />
    <rect x="102" y="114" width="28" height="5" fill="#C68B4E" />
    <rect x="102" y="172" width="28" height="5" fill="#C68B4E" />
    <rect x="102" y="230" width="28" height="5" fill="#C68B4E" />
    <rect x="102" y="288" width="28" height="5" fill="#C68B4E" />
    <g class="h-bucket">
      <rect x="110" y="276" width="12" height="12" rx="2" fill="#E53935" stroke="#1D2B4F" stroke-width="1.5" />
    </g>
  </g>

  <!-- 5: materiales en el andén (hasta 90%) -->
  <g {...at(5)}>
    <g {...until(90)}>
      <rect x="342" y="338" width="16" height="8" fill="#D9825B" stroke="#1D2B4F" stroke-width="1" />
      <rect x="358" y="338" width="16" height="8" fill="#D9825B" stroke="#1D2B4F" stroke-width="1" />
      <rect x="350" y="330" width="16" height="8" fill="#D9825B" stroke="#1D2B4F" stroke-width="1" />
      <rect x="378" y="332" width="22" height="16" rx="3" fill="#E0E0E0" stroke="#1D2B4F" stroke-width="1" />
      <rect x="384" y="320" width="22" height="14" rx="3" fill="#EEEEEE" stroke="#1D2B4F" stroke-width="1" />
    </g>
  </g>

  <!-- Cerca de obra (hasta 90%) -->
  <g {...until(90, 'h-fence')}>
    {Array.from({ length: 12 }, (_, i) => (
      <rect x={100 + i * 21} y="324" width="19" height="26" fill={i % 2 ? '#FF7043' : '#fff'} stroke="#1D2B4F" stroke-width="1.5" />
    ))}
    <rect x="98" y="322" width="254" height="4" fill="#1D2B4F" />
  </g>

  <!-- 75: letrero LA SUPER CASA -->
  <g {...at(75)}>
    <path d="M330 72H446M330 96L372 72" stroke="#1D2B4F" stroke-width="5" stroke-linecap="round" />
    <path d="M372 72v14M424 72v14" stroke="#1D2B4F" stroke-width="2" />
    <path d="M354 66h10l-2 6h-6zM430 66h10l-2 6h-6z" fill="#1D2B4F" />
    <path d="M348 86H448V146L398 196L348 146Z" fill="#2F80ED" stroke="#1D2B4F" stroke-width="3" stroke-linejoin="round" />
    <path d="M356 93H440V143L398 185L356 143Z" fill="#FFD400" />
    <text x="398" y="111" text-anchor="middle" font-family="'Baloo 2', system-ui, sans-serif" font-weight="800" font-size="14" fill="#C62828">
      LA
    </text>
    <g transform="rotate(-8 398 128)">
      <rect x="344" y="114" width="108" height="26" rx="4" fill="#E53935" stroke="#1D2B4F" stroke-width="2.5" />
      <text x="398" y="134" text-anchor="middle" font-family="'Baloo 2', system-ui, sans-serif" font-weight="800" font-size="22" fill="#fff">
        SUPER
      </text>
    </g>
    <text x="398" y="166" text-anchor="middle" font-family="'Baloo 2', system-ui, sans-serif" font-weight="800" font-size="20" fill="#C62828">
      CASA
    </text>
  </g>

  <!-- 85: árboles y arbustos -->
  <g {...at(85)}>
    <rect x="94" y="300" width="9" height="52" fill="#8D5A3B" />
    <circle cx="98" cy="292" r="24" fill="#43A047" stroke="#1D2B4F" stroke-width="1.5" />
    <circle cx="82" cy="276" r="14" fill="#4CAF50" /><circle cx="110" cy="272" r="15" fill="#4CAF50" />
    <rect x="378" y="296" width="9" height="56" fill="#8D5A3B" />
    <circle cx="382" cy="286" r="24" fill="#43A047" stroke="#1D2B4F" stroke-width="1.5" />
    <circle cx="368" cy="270" r="14" fill="#4CAF50" /><circle cx="396" cy="268" r="15" fill="#4CAF50" />
    {[140, 158, 176, 296, 314].map((x, i) => <circle cx={x} cy="350" r={i % 2 ? 9 : 11} fill={i % 2 ? '#2E7D32' : '#43A047'} />)}
  </g>

  <!-- 90: reja negra -->
  <g {...at(90)}>
    <path d="M124 322H336M124 346H336" stroke="#1D2B4F" stroke-width="3" />
    {Array.from({ length: 27 }, (_, i) => <path d={`M${126 + i * 8} 316V350`} stroke="#1D2B4F" stroke-width="2.2" />)}
  </g>

  <!-- 95: luces de azotea, letrero iluminado y familia llegando -->
  <g {...at(95, 'h-final')}>
    <path d="M128 32Q230 46 332 32" stroke="#1D2B4F" stroke-width="1" fill="none" />
    {bulbs.map((b) => <circle class="h-bulb" cx={b.x} cy={b.y + 2} r="3.2" fill={b.c} />)}
    <circle class="h-bulb" cx="359" cy="75" r="4" fill="#FFE082" />
    <circle class="h-bulb" cx="435" cy="75" r="4" fill="#FFE082" />
    <g class="h-family">
      <circle cx="40" cy="330" r="8" fill="#F7C9A6" stroke="#1D2B4F" stroke-width="1.5" />
      <path d="M31 340Q40 335 49 340L51 372H29Z" fill="#8E5CC9" stroke="#1D2B4F" stroke-width="1.5" />
      <circle cx="62" cy="346" r="7" fill="#F7C9A6" stroke="#1D2B4F" stroke-width="1.5" />
      <path d="M56 344h12l-2 -3h-8z" fill="#4CAF50" />
      <path d="M55 355Q62 351 69 355L69 372H55Z" fill="#2F80ED" stroke="#1D2B4F" stroke-width="1.5" />
      <path d="M54 355L46 366L47 376L58 370Z" fill="#E53935" />
      <path d="M48 346L56 355" stroke="#1D2B4F" stroke-width="2.5" stroke-linecap="round" />
    </g>
  </g>

  <!-- 100: celebración -->
  <g {...at(100)}>
    {confetti.map((c) => <polygon class="h-star" points={starPoints(c.x, c.y, c.s)} fill={c.c} />)}
  </g>
</svg>

<style>
  .house {
    display: block;
    width: 100%;
    height: auto;
  }
  [data-at] {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 1.1s ease,
      transform 1.1s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  [data-at].on {
    opacity: 1;
    transform: none;
  }
  [data-until] {
    transition:
      opacity 1.1s ease,
      transform 1.1s ease;
  }
  [data-until].off {
    opacity: 0;
    transform: translateY(16px);
  }
  /* Un elemento que aparece y luego se retira (materiales) */
  [data-at].on [data-until].off {
    opacity: 0;
  }

  /* Obra en movimiento (≥15%) */
  .h-hook,
  .h-bucket {
    transform-box: view-box;
  }
  .is-active .h-hook {
    transform-origin: 250px 29px;
    animation: swing 3.2s ease-in-out infinite;
  }
  .is-active .h-bucket {
    animation: lift 4s ease-in-out infinite;
  }
  .h-final.on .h-bulb {
    animation: twinkle 1.6s ease-in-out infinite alternate;
  }
  .h-final.on .h-bulb:nth-of-type(2n) {
    animation-delay: 0.8s;
  }
  .on .h-star {
    transform-box: fill-box;
    transform-origin: center;
    animation: float 3s ease-in-out infinite;
  }
  .h-final.on .h-family {
    animation: arrive 1.6s ease-out both;
  }
  .house.is-building {
    animation: build 0.9s cubic-bezier(0.34, 1.56, 0.64, 1);
    transform-origin: 50% 100%;
  }

  @keyframes swing {
    0%,
    100% {
      transform: rotate(-5deg);
    }
    50% {
      transform: rotate(5deg);
    }
  }
  @keyframes lift {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-150px);
    }
  }
  @keyframes twinkle {
    from {
      opacity: 0.45;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes float {
    0%,
    100% {
      transform: translateY(0) rotate(0);
    }
    50% {
      transform: translateY(-6px) rotate(20deg);
    }
  }
  @keyframes arrive {
    from {
      transform: translateX(-50px);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  @keyframes build {
    0% {
      transform: scale(1);
    }
    30% {
      transform: scale(0.97, 1.03);
    }
    60% {
      transform: scale(1.02, 0.98);
    }
    100% {
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-at],
    [data-until] {
      transition-duration: 0.01s;
    }
    .house *,
    .house.is-building {
      animation: none !important;
    }
  }
</style>
