---
import { calvitoSVG, type CalvitoOptions } from './calvito';

interface Props extends CalvitoOptions {
  label: string;
  class?: string;
}

const { label, class: className = '', ...opts } = Astro.props;
---

<svg
  class:list={['calvito', className]}
  viewBox="0 -20 200 260"
  role="img"
  aria-label={label}
  set:html={calvitoSVG(opts)}
/>

<style>
  .calvito {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 10px 14px rgb(29 43 79 / 0.18));
  }
</style>
