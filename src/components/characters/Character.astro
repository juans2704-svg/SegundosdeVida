---
import { characters, type CharacterId } from '../../config/characters';

interface Props {
  who: CharacterId;
  /** Texto alternativo propio; por defecto el de la configuración. */
  alt?: string;
  eager?: boolean;
  class?: string;
}

const { who, alt, eager = false, class: className = '' } = Astro.props;
const c = characters[who];
---

<figure class:list={['character', { 'character--cutout': 'cutout' in c && c.cutout }, className]}>
  <img
    src={c.src}
    width={c.width}
    height={c.height}
    alt={alt ?? c.alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={eager ? 'high' : undefined}
  />
</figure>

<style>
  .character {
    margin: 0;
    border: 3px solid var(--ink);
    border-radius: 26px;
    overflow: hidden;
    background: var(--sky);
    box-shadow: var(--shadow);
    transform: rotate(-2deg);
  }
  .character--cutout {
    border: 0;
    border-radius: 0;
    overflow: visible;
    background: none;
    box-shadow: none;
    transform: none;
  }
  .character--cutout img {
    filter: drop-shadow(0 12px 14px rgb(29 43 79 / 0.25));
  }
  .character img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
