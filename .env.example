# ─── Pagos en el navegador ───────────────────────────────────────────────
# demo: si no hay servidor, simula los pagos en la página. live: checkout real.
PUBLIC_PAYMENTS_MODE=demo

# ─── Wompi (servidor) ────────────────────────────────────────────────────
# Sin llaves, el servidor simula a Wompi (modo de pruebas sin cobros).
# Con llaves pub_test_/prv_test_ usa el sandbox de Wompi; con pub_prod_/prv_prod_, producción.
# Panel de Wompi → Desarrolladores → Llaves del API y Secretos.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# ─── Base de datos (Supabase → Project Settings → Database → Connection string) ──
# En Vercel usar el pooler en modo transacción (puerto 6543).
# Sin DATABASE_URL los datos se guardan en memoria (solo para desarrollo).
DATABASE_URL=

# ─── Panel /admin (usuario: admin o editor) ──────────────────────────────
ADMIN_PASSWORD=
EDITOR_PASSWORD=

# ─── Cron de cobros mensuales (Vercel lo envía automáticamente) ──────────
CRON_SECRET=

# ─── Medición ────────────────────────────────────────────────────────────
PUBLIC_GA4_ID=
PUBLIC_META_PIXEL_ID=
